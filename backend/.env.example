GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App
APP_NAME="AI Memory Assistant"
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-this-in-production-32chars

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_memory
DATABASE_ECHO=false

# Vector Store (chroma | faiss | pinecone | weaviate)
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_db

# Embedding (sentence_transformers | gemini | openai | instructor)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM (google | openai | anthropic | ollama)
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7

# RAG Settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_MAX_CONTEXT_TOKENS=2000
RAG_RERANK_ENABLED=true

# Memory
MEMORY_IMPORTANCE_THRESHOLD=0.3
MEMORY_TTL_DAYS=365

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
